{
  "name": "bookmark-manager",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "gendb": "bunx prisma migrate dev",
    "db:studio": "bunx prisma studio",
    "lint": "eslint src/ tests/",
