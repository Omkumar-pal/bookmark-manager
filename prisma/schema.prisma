datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Folder {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  bookmarks Bookmark[]

  @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(uuid())
  title     String
  url       String
  tags      String[]
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([folderId])
  @@index([title])
  @@index([createdAt, id])
}
